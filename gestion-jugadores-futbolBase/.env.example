# ============================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL
# ============================================
# Este archivo contiene valores por defecto para desarrollo
# NO subir este archivo con valores reales a producción

# Database Configuration
DATABASE_URL=jdbc:mysql://localhost:3306/control_jugadores
DATABASE_USERNAME=root
DATABASE_PASSWORD=1234

# JWT Security
# IMPORTANTE: Cambiar este secret por uno seguro de mínimo 32 caracteres aleatorios
JWT_SECRET=examportal_dev_secret_key_change_in_production_minimum_32_chars
JWT_EXPIRATION=36000000

# CORS Configuration
# Separar múltiples origenes con comas
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost:8101
